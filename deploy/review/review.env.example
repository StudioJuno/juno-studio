HOST=127.0.0.1
PORT=8788
JUNO_REVIEW_DATA=/var/lib/juno-review
JUNO_REVIEW_URL=https://clients.studio-juno.fr
JUNO_REVIEW_DOMAIN=clients.studio-juno.fr
JUNO_REVIEW_QUOTA_GB=100
# Caddy (Caddyfile, même machine) écrit l'adresse réelle du client dans
# X-Forwarded-For : on peut la croire. Laissez 0 derrière un autre proxy qui
# transmettrait l'en-tête du client tel quel.
JUNO_TRUST_PROXY=1
# Generate locally with setup.mjs. Do not send this key in chat or commit it.
JUNO_REVIEW_BOOTSTRAP_TOKEN=GENERATE_A_RANDOM_KEY_BEFORE_STARTING

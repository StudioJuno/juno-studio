{
  "name": "juno-studio",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "description": "Le studio photo et vidéo des équipes Juno",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && npm run build:review",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "electron .",
    "test": "npm run test:unit && npm run test:native",
    "package:mac": "node scripts/package.mjs darwin arm64",
    "package:win": "node scripts/package.mjs win32 x64",
    "prebuild": "node scripts/prepare-assets.mjs",
    "test:team": "node --test tests/team-server.test.mjs tests/team-scale.test.mjs tests/local-service.test.mjs",
    "team": "node server/team-server.mjs",
    "package:mac-intel": "node scripts/package.mjs darwin x64",
    "test:export": "node --test tests/export-resume.test.cjs",
    "test:video": "vitest run tests/video-edit.test.ts && node --test tests/video.test.cjs tests/video-native.test.cjs tests/video-generation-jobs.test.cjs",
    "test:import": "vitest run tests/raw-session.test.ts tests/import-recovery.test.ts && node --test tests/import-native.test.cjs",
    "test:media": "node --test tests/media-import.test.cjs",
    "test:native": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:culling": "vitest run tests/quality.test.ts tests/auto-tone.test.ts tests/people.test.ts",
    "test:masks": "vitest run tests/masks.test.ts tests/transform.test.ts tests/depth.test.ts && node --test tests/masks-native.test.cjs tests/track-native.test.cjs",
    "test:all": "npm test",
    "build:review": "tsc -p tsconfig.review.json --noEmit && vite build --config vite.review.config.ts",
    "test:review": "vitest run tests/review-map.test.ts && node --test tests/review-server.test.mjs tests/review-native.test.cjs",
    "review": "node server/review/server.mjs",
    "sign:mac": "node scripts/sign-mac.mjs",
    "notarize:mac": "node scripts/notarize-mac.mjs",
    "test:unit": "vitest run",
    "test:modeles": "node scripts/test-modeles.mjs",
    "package:review": "node scripts/package-review.mjs",
    "updates:key": "node scripts/update-key.mjs",
    "publish:updates": "node scripts/publish-updates.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@mediapipe/tasks-vision": "^0.10.32",
    "@vladmandic/face-api": "^1.7.15",
    "exifr": "^7.1.3",
    "idb": "^8.0.2",
    "jszip": "^3.10.1",
    "lcms-wasm": "^1.0.5",
    "libraw-wasm": "^1.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/utif": "^3.0.6",
    "electron": "^44.4.3",
    "fake-indexeddb": "^6.2.4",
    "prettier": "^3.6.2",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
